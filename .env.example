# Configuration de ClaudeShare. Copier en `.env` — qui est ignoré par git.
#
# Tout est préfixé `CLAUDESHARE_` : le préfixe évite qu'une variable d'un autre
# outil se retrouve interprétée comme un réglage d'ici.

# --------------------------------------------------------------- identité

# Applications OAuth. Sans au moins une, personne ne peut se connecter — il n'y
# a volontairement aucun mode de contournement, même pour le développement : ce
# serveur donne accès à un agent qui a un shell.
# URL de rappel à déclarer chez le fournisseur :
#   http://127.0.0.1:8765/auth/github/callback   (local)
#   https://VOTRE-DOMAINE/auth/github/callback   (déploiement)
CLAUDESHARE_GITHUB_CLIENT_ID=
CLAUDESHARE_GITHUB_CLIENT_SECRET=
CLAUDESHARE_GOOGLE_CLIENT_ID=
CLAUDESHARE_GOOGLE_CLIENT_SECRET=

# Signature des cookies de session. Sans elle, une clé éphémère est générée à
# chaque démarrage : les sessions ne survivent pas à un redéploiement.
#   openssl rand -base64 32
CLAUDESHARE_SECRET_KEY=

# ------------------------------------------------------------ facturation

# `pilot` (défaut) : abonnement de l'hôte, l'hôte seul écrit à Claude.
# `free`  : clé API, facturation à l'usage, tout porteur de `room.speak` écrit.
# En mode pilote, une ANTHROPIC_API_KEY dans l'environnement fait **refuser le
# démarrage** — le CLI la préférerait à l'abonnement sans rien dire.
CLAUDESHARE_AUTH_MODE=pilot

# ------------------------------------------------------------- persistance

# Vide : SQLite sous la racine des workspaces. Sinon, une URL Postgres.
# Un `postgres://` copié depuis un tableau de bord est accepté tel quel.
CLAUDESHARE_DATABASE_URL=

# `create` : create_all au démarrage (local, tests).
# `migrate` : `alembic upgrade head` au démarrage (déploiement).
# `none` : les migrations sont appliquées ailleurs (`claudeshare migrate`).
CLAUDESHARE_DB_SCHEMA=create

# Événements de collaboration conservés par salon. 0 désactive l'élagage.
CLAUDESHARE_EVENT_RETENTION=5000

# --------------------------------------------------------------- diffusion

# Vide : diffusion en mémoire. Une URL Redis la partage entre process — mais ne
# suffit **pas** à faire du multi-worker : un salon est une session épinglée à
# un process, et `serve` refuse `--workers > 1`. Voir `core/broker.py`.
CLAUDESHARE_REDIS_URL=

# ---------------------------------------------------------------- exposition

# À n'activer que derrière une terminaison TLS réelle : un cookie `Secure` sur
# une origine en clair n'est jamais renvoyé, et HSTS épinglerait les navigateurs
# sur une adresse qu'on ne sait pas servir.
CLAUDESHARE_PUBLIC_HTTPS=false

# Proxys de confiance pour `X-Forwarded-*`, au format uvicorn. `*` n'est correct
# que si rien d'autre ne peut joindre le port du serveur. Sans ça, tout le monde
# partage le seau de limitation du proxy.
CLAUDESHARE_TRUSTED_PROXIES=

CLAUDESHARE_RATE_LIMIT=true

# ------------------------------------------------------------------ docker

# Racine sous laquelle tous les dossiers de salon sont confinés. C'est la seule
# partie de votre machine que le conteneur voit.
CLAUDESHARE_WORKSPACES=./workspaces
CLAUDESHARE_PORT=8765

# Utilisés par `docker-compose.deploy.yml` uniquement.
CLAUDESHARE_DOMAIN=
POSTGRES_PASSWORD=

# --- agents lancés par le relais (déploiement sur un serveur unique) ---
# Chiffre les identifiants Anthropic déposés par les profils. Sans elle, le
# relais refuse d'en conserver plutôt que de les écrire en clair.
CLAUDESHARE_CREDENTIAL_KEY=

# Lancer des agents pour ses utilisateurs. Désactivé par défaut : c'est
# exécuter du shell en leur nom sur sa propre machine.
CLAUDESHARE_MANAGED_AGENTS=false
CLAUDESHARE_AGENT_ROOT=./state/agents
CLAUDESHARE_INTERNAL_URL=http://127.0.0.1:8765
